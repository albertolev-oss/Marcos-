# Railway sets PORT automatically. Local default: 3000.
PORT=3000
# Public HTTPS Railway URL used in the ChatGPT Action schema.
# PUBLIC_BASE_URL=https://your-service.up.railway.app

# PACS / VisualMedica defaults. Do not commit real credentials.
PACS_BASE_URL=https://pacs.fcm.unc.edu.ar
PACS_WEB_PATH=/
PACS_DICOMWEB_PATH=/dicom-web
PACS_VENDOR=VisualMedica

# Optional: require clients (including GPT Actions) to send x-api-key.
CONNECTOR_API_KEY=change-me

# Optional: if your institutional proxy exposes safe read-only search endpoints.
# PACS_PROXY_BASE_URL=https://your-authorized-proxy.example.com
# PACS_PROXY_TOKEN=replace-in-railway-only
