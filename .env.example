NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=https://clinical-agent.example.internal
# A long random value (openssl rand -hex 32). Never commit the real value.
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
# Argon2/bcrypt hash should be used by an upstream identity provider in production.
APP_ACCESS_TOKEN=replace-for-local-development-only
ALLOWED_DOMAINS=demo.sihosp.example
ALLOW_CLINICAL_WRITES=false
SESSION_IDLE_MINUTES=15
BROWSER_PROFILE_PATH=/data/chromium-profile
BROWSER_ENABLED=true
NOVNC_URL=/novnc/vnc.html?autoconnect=true&resize=scale&view_only=false
SCREEN_WIDTH=430
SCREEN_HEIGHT=932
SCREENSHOT_STORAGE_ENABLED=false
ENCRYPTION_KEY=replace-with-32-byte-base64-key
