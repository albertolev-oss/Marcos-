# La aplicación rechaza cualquier otro valor.
ALLOW_CLINICAL_WRITES=false
PORT=8080
SCREEN_SIZE=1280x800x24
# Para la demostración, restringe la navegación al sitio ficticio.
DEMO_ORIGIN=http://mock-sihosp:8081

# Opcional: prueba remota de Agents API. Sin clave, npm test funciona offline.
AGENTS_ENABLED=false
AGENTS_MODEL=gpt-6-astra
# Clave únicamente en entorno del servidor, nunca en Git, UI o prompts.
OPENAI_API_KEY=

# Modo de este proceso: demo (default), sihosp o pacs.
# El compose institucional inicia dos procesos con perfiles separados.
BROWSER_MODE=demo
